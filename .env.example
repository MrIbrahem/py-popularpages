# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
#
# Credentials are read at runtime via python-dotenv (see src/src_py/popularpages/config.py).
# Real environment variables (e.g. in Toolforge) take precedence over this file.

# --- Wikipedia bot credentials ---
# Obtain these at [[Special:BotPasswords]] on the appropriate wiki.
# Use the full bot name, e.g. "ExampleBot@MyTask".
WIKIPEDIA_BOT_USERNAME=
WIKIPEDIA_BOT_PASSWORD=

# --- Wikimedia replica database access (Toolforge environment) ---
# These cannot be used in local development without SSH tunnels.
TOOL_REPLICA_HOST=analytics.db.svc.wikimedia.cloud
TOOL_REPLICA_USER=root
TOOL_REPLICA_PASSWORD=root
TOOL_REPLICA_PORT=3306
